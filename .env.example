# Histora environment variables.
# Copy to .env.local for local development. Set the SAME variable names with
# DIFFERENT values in production (separate dev and prod Supabase projects).
# .env* is gitignored; this example file is intentionally committed and contains
# no secrets — only placeholder names.

# --- Supabase (Phase 2+, Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only: never prefix with NEXT_PUBLIC_, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- FastAPI backend (Phase 5+) ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Ingestion adapters (Phase 4+): leave empty until configured ---
# Europeana: https://pro.europeana.eu/page/get-api — never hardcode keys in source.
EUROPEANA_API_KEY=
# Wikimedia requires a descriptive User-Agent with contact info:
# https://foundation.wikimedia.org/wiki/Policy:User-Agent_policy
WIKIMEDIA_USER_AGENT=Histora/0.1 (replace-with-contact@example.org)
# Library of Congress: https://www.loc.gov/apis/json/ (most endpoints are keyless).
LOC_API_KEY=

# --- Reserved for later phases (introduce when the phase lands) ---
# LLM_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1536

# --- Historical Guide (server-only; never prefix with NEXT_PUBLIC_) ---
# Google Gemini key used by the server API route for the RAG-guided Historical
# Guide. When unset, the Guide falls back to its local keyword engine. Make a
# key at https://aistudio.google.com/ and copy it into .env.local.
GEMINI_API_KEY=your_gcp_api_key_here
# Model id; defaults to "gemini-2.0-flash" when unset.
GEMINI_MODEL=1086765372721
